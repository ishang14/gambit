# Copy to .env (never commit .env). Docker Compose reads it automatically.

# --- Development (docker-compose.yml) -------------------------------------
# Backend settings when running the API outside Docker:
MONGO_URL=mongodb://localhost:27017
MONGO_DB=gambit
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
# Frontend, when running Vite outside Docker:
VITE_API_URL=http://localhost:8000

# --- Production (docker-compose.prod.yml) ---------------------------------
# Required. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Port nginx listens on (default 80).
WEB_PORT=80
# Stockfish search depth per position (see backend/benchmarks/results.md).
ANALYSIS_DEPTH=14
